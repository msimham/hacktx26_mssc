# Server-side only. Never commit .env.
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_REASONING_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_ALLOW_CONTRIBUTOR=false
SERPAPI_API_KEY=
FB_APP_SECRET=
ORGANIZER_PASSCODE=change-me
PORT=3001
# Client (public — app id is not secret)
VITE_FB_APP_ID=
# Optional
# DATA_DIR=            # where sessions are stored (default: server/data, gitignored)
# RETENTION_DAYS=30    # finished sessions older than this are deleted on startup
# FB_ENABLE_FRIENDS=false        # user_friends is Development-mode only and unverified; leave off unless you are testing it
# VITE_FB_GRAPH_VERSION=v21.0    # Graph API version used by the Facebook JS SDK (check it matches your app)
# ASSETS_DIR=                    # where generated art is cached (default: server/assets-cache, gitignored)
