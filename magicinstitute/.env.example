# Copy to .env (which is gitignored; never commit real keys)
MUSE_API_KEY=
ANTHROPIC_API_KEY=
# Social ladder: group/place discovery via SerpAPI
SERPAPI_KEY=
# Optional Facebook Login (user-consented profile signals only; Meta removed the Groups API)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match "Valid OAuth Redirect URIs" in the Facebook app. https is required outside localhost.
FB_REDIRECT_URI=http://localhost:8000/api/facebook/callback
# FB_SCOPES=public_profile,user_location,user_hometown,user_friends
